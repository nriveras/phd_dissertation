  <!-- LABELALPHA NAME TEMPLATE -->
  <bcf:labelalphanametemplate name="global">
    <bcf:namepart order="1" use="1" pre="1" substring_width="1" substring_compound="1">prefix</bcf:namepart>
    <bcf:namepart order="2">family</bcf:namepart>
